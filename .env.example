# ==============================
# Meta (Facebook) Ads API
# ==============================
# Tu Access Token de Meta Business
# Obtener en: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=TU_META_ACCESS_TOKEN_AQUI

# Tu Ad Account ID (sin el prefijo "act_")
# Encontrar en: Business Settings > Ad Accounts
META_AD_ACCOUNT_ID=TU_AD_ACCOUNT_ID_AQUI

# ==============================
# Shopify API
# ==============================
# Tu dominio de tienda (ej: mi-tienda.myshopify.com)
SHOPIFY_STORE_URL=tu-tienda.myshopify.com

# Access Token (se rellena automáticamente via OAuth o ponlo manualmente)
SHOPIFY_ACCESS_TOKEN=

# API Key y Secret de tu app en Partners Dashboard
# Partners Dashboard → Tu app → API credentials
SHOPIFY_API_KEY=TU_API_KEY
SHOPIFY_API_SECRET=TU_API_SECRET

# ==============================
# Telegram Alerts (opcional)
# ==============================
# Token del bot (obténlo de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=

# Tu Chat ID personal (obténlo de @userinfobot en Telegram)
TELEGRAM_CHAT_ID=

# ROAS mínimo — si baja de este valor se enviará alerta (por defecto: 2.0)
ALERT_ROAS_THRESHOLD=2.0

# ==============================
# Server
# ==============================
PORT=3001
